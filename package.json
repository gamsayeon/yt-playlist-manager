  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-web-extension": "^4.1.1"
  }
